# Copy to .env (never commit .env). Every value here is optional for local use.

# Database password used by docker compose (db + backend)
DB_PASSWORD=change-me-local-only

# Required for SPRING_PROFILES_ACTIVE=prod. Generate with:  openssl rand -base64 48
# JWT_SECRET=

# ---------------- AI provider ----------------
# Default: offline mock (no key, no cost, deterministic). Leave the lines below commented to keep it.

# Option A - Google Gemini (free tier with limits; check current quotas at ai.google.dev/pricing)
# AI_PROVIDER=spring-ai
# SPRING_AI_CHAT=openai
# SPRING_AI_EMBEDDING=openai
# AI_API_KEY=your-gemini-key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_CHAT_MODEL=gemini-flash-latest
# AI_EMBED_MODEL=gemini-embedding-001

# Option B - Ollama on your own computer (free, private, slower on CPU)
#   docker compose --profile ollama up -d ollama
#   docker compose exec ollama ollama pull llama3.2:3b
#   docker compose exec ollama ollama pull nomic-embed-text
# AI_PROVIDER=spring-ai
# SPRING_AI_CHAT=openai
# SPRING_AI_EMBEDDING=openai
# AI_API_KEY=ollama
# AI_BASE_URL=http://ollama:11434
# AI_CHAT_PATH=/v1/chat/completions
# AI_EMBED_PATH=/v1/embeddings
# AI_CHAT_MODEL=llama3.2:3b
# AI_EMBED_MODEL=nomic-embed-text
# DUP_MIN_SEMANTIC=0.75
